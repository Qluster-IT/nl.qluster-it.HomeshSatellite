{
  "id": "nl.qluster-it.HomeshSatellite",
  "version": "0.0.4",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Homesh Satellite"
  },
  "description": {
    "en": "Let's you control this Homey by another Homey"
  },
  "category": [
    "appliances"
  ],
  "permissions": ["homey:app:com.athom.soundboard", "homey:app:openmindnl.ledcollection", "homey:app:nl.fellownet.leditbe"],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "brandColor": "#0066a4",
  "screensavers": [
    {
      "name": "main",
      "title": {
        "en": "Controlled by Homesh",
        "nl": "Door Homesh beheerd"
      }
    }
  ],
  "api": {
    "getAuthorization": {
      "method": "POST",
      "path": "/getauthorization/",
      "public": true
    },
    "startFlow": {
      "method": "POST",
      "path": "/startflow/",
      "public": true
    },
    "getFlowEventNames": {
      "method": "POST",
      "path": "/getFlowEventNames/",
      "public": true
    },
    "playUrl": {
      "method": "POST",
      "path": "/playUrl/",
      "public": true
    },
    "sayAthom": {
      "method": "POST",
      "path": "/sayAthom/",
      "public": true
    },
    "getSoundboards": {
      "method": "POST",
      "path": "/getSoundboards/",
      "public": true
    },
    "playSoundboard": {
      "method": "POST",
      "path": "/playSoundboard/",
      "public": true
    },
    "getScreensavers": {
      "method": "POST",
      "path": "/getScreensavers/",
      "public": true
    },
    "setScreensaver": {
      "method": "POST",
      "path": "/setScreensaver/",
      "public": true
    }
  }
}