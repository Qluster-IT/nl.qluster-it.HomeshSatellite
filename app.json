{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.qluster-it.BlackWholeSatellite",
  "version": "0.0.3",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "BlackWhole Satellite"
  },
  "description": {
    "en": "Let's you control this Homey by a(nother) BlackWhole Controller"
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:manager:speech-output"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "api": {
    "getAuthorization": {
      "method": "POST",
      "path": "/getauthorization/",
      "public": true
    },
    "startFlow": {
      "method": "POST",
      "path": "/startflow/",
      "public": true
    },
    "getFlowEventNames": {
      "method": "POST",
      "path": "/getFlowEventNames/",
      "public": true
    },
    "playUrl": {
      "method": "POST",
      "path": "/playUrl/",
      "public": true
    },
    "sayAthom": {
      "method": "POST",
      "path": "/sayAthom/",
      "public": true
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "trigger__startflow__text1_number1_boolean1",
        "title": {
          "en": "This Flowcard started",
          "nl": "Deze Flowkaart is gestart"
        },
        "titleFormatted": {
          "en": "[[name]] started (1 text, 1 number, 1 yes/no)",
          "nl": "[[name]] is gestart (1 tekst, 1 nummer, 1 ja/nee)"
        },
        "args": [
          {
            "type": "text",
            "name": "name",
            "placeholder": {
              "en": "Type a trigger name",
              "nl": "Type een trigger naam"
            },
            "title": {
              "en": "Triggername",
              "nl": "Triggernaam"
            }
          }
        ],
        "tokens": [
          {
            "type": "string",
            "name": "text1",
            "title": {
              "en": "Text 1",
              "nl": "Tekst 1"
            }
          },
          {
            "type": "number",
            "name": "number1",
            "title": {
              "en": "Number 1",
              "nl": "Nummer 1"
            }
          },
          {
            "type": "boolean",
            "name": "boolean1",
            "title": {
              "en": "Yes/No 1",
              "nl": "Ja/Nee 1"
            }
          }
        ]
      }
    ]
  }
}